# Copy this file to `.env` and adjust if needed:
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# LLM_API_KEY below is a shared, temporary workshop key. It will be
# deactivated after the workshop; request a personal Marvin key for
# anything beyond it. A key already set in the shell environment wins:
# python-dotenv never overrides existing environment variables.

# Default: Marvin (LiteLLM proxy, reachable via AKROS VPN only).
LLM_BASE_URL=http://marvin-backend.akros.ch:8080
LLM_MODEL=marvin-documents-candidate      # chat (alternative: marvin-documents-candidate)
EMBED_MODEL=marvin-embed       # embeddings (BGE-M3)
RERANK_MODEL=BAAI/bge-reranker-v2-m3  # local multilingual cross-encoder
LLM_API_KEY=sk-yOU3DkXOwHjauAuqiATpsQ  # temporary workshop key

# Remote alternative: rerank on the Marvin backend instead of the local
# cross-encoder. Requires the virtual key to be allowed for the rerank model
# (currently NOT the case for standard keys — ask the Marvin admins):
#   RERANK_URL=http://marvin-backend.akros.ch:8080/nexa/v1/reranking
#   RERANK_MODEL=NexaAI/jina-v2-rerank-mlx
